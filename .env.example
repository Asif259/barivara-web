# ==============================================================================
# BariVara Web (Frontend) Environment Variables
# ==============================================================================

# API Base URL (Backend REST API endpoint)
# Local: http://localhost:4000/api/v1
# Production: https://api.barivara.app/api/v1 (or hosted API endpoint)
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1

# Canonical Production Site URL (used for SEO canonical tags, Open Graph, and sitemap)
NEXT_PUBLIC_SITE_URL=https://barivara-web.vercel.app
